NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/hoof_public

# Clerk (required)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated frontend origins (recommended for production)
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://app.example.com

# Infisical (optional — omit to use .env directly)
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=dev

# Moesif (optional)
# MOESIF_APPLICATION_ID=

# AWS
AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=hoof-public
# AWS_EVENT_BUS_NAME=default
